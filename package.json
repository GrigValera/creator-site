{
  "name": "creator-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/start.mjs",
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native --emptyOutDir && vite build --configLoader native --ssr src/entry-server.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview --configLoader native",
    "check": "tsc --noEmit",
    "prepackage:alwaysdata": "npm run build",
    "package:alwaysdata": "node scripts/package-alwaysdata.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
